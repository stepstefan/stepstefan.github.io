<table class="skills-table">
  <tbody>
    {% for content in data[1] %}
      <tr title="{{ content.level }}">
        <th scope="row">{{ content.name }}</th>
        <td>
          {% for keyword in content.keywords %}
            <span class="skill">{{ keyword }}</span>
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
